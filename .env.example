# Placeholder Shopify credentials for local development of apps/shopify-app.
# Copy to apps/shopify-app/.env and fill in real values from your Shopify
# Partner dashboard (or let `shopify app dev` / `shopify app env pull` manage
# them). Never commit real secrets.

SHOPIFY_API_KEY=replace-with-client-id
SHOPIFY_API_SECRET=replace-with-client-secret
SHOPIFY_APP_URL=https://localhost:3000
SCOPES=write_products

# Postgres connection string (Neon in dev) — placeholder, real value lives in .env only
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Google AI Studio API key for the Gemini provider adapter (packages/provider-gemini)
GEMINI_API_KEY="your-gemini-api-key"

# Token guarding the /internal/costs admin route (apps/shopify-app), presented
# as ?token=... ; the route 404s when unset. Any long random string works in dev.
ADMIN_TOKEN="your-admin-token"

# Playground search API (app/routes/api.playground.*) — see docs/ARCHITECTURE.md.
# Tenant key of the seed catalog searched when no ?catalog= slug is given;
# unset makes /api/playground/search answer 503 for seed-catalog requests.
PLAYGROUND_SEED_STORE_KEY=""
# Abuse ceilings for the unauthenticated playground AI path; over a ceiling the
# search is served classic with degraded=true. Defaults apply when unset.
PLAYGROUND_AI_THROTTLE_PER_MINUTE=10
PLAYGROUND_DAILY_AI_CAP=2000
PLAYGROUND_CATALOG_DAILY_AI_CAP=500
