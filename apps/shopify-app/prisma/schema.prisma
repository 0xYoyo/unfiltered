// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Cost-metering ledger: one row per AI call, written through the CostRecorder
// port so no AI spend is ever unmetered.
model AiCall {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  provider     String
  modelId      String
  operation    String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  shopDomain   String?
  searchId     String?

  @@index([searchId])
}

// Per-shop catalog snapshot: one row per Shopify product, in the shape the
// engine and later enrichment/embedding steps consume (YOY-20).
model CatalogProduct {
  id              String   @id @default(uuid())
  shopDomain      String
  productId       String
  title           String
  description     String
  tags            String[]
  vendor          String
  productType     String
  priceMin        Float
  priceMax        Float
  currencyCode    String
  available       Boolean
  // Shopify product status (YOY-61 AC-3). Ingestion and webhook sync only
  // ever write ACTIVE products, so this stays "ACTIVE" in practice; both
  // search stores still filter on it as defense in depth — a non-active row
  // that reaches the table by any other path must never be served.
  status          String   @default("ACTIVE")
  imageAltTexts   String[]
  // Display-only snapshot fields (YOY-44): storefront handle and featured
  // image for result cards. Deliberately OUTSIDE contentHash — a change here
  // must not dirty the searchable content or trigger re-enrichment.
  handle          String   @default("")
  featuredImageUrl String?
  sourceUpdatedAt DateTime
  // SHA-256 over the searchable fields; unchanged hash means the row is
  // untouched on re-ingestion.
  contentHash     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shopDomain, productId])
  @@index([shopDomain])
}

// LLM-derived structured attributes for one snapshot row (YOY-22). Keyed by
// the snapshot's contentHash so enrichment is cached: an unchanged product
// re-enriches with zero LLM calls. status is "enriched" or "failed"; failed
// rows keep the hash so a deterministic bad product is not retried until its
// content changes.
model ProductEnrichment {
  id          String   @id @default(uuid())
  shopDomain  String
  productId   String
  contentHash String
  status      String
  category    String?
  colors      String[]
  occasions   String[]
  fit         String?
  styleTags   String[]
  seasons     String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopDomain, productId])
  @@index([shopDomain])
}

// pgvector embedding for one snapshot row (YOY-23), keyed by the snapshot's
// contentHash so embedding runs are incremental: an unchanged product re-runs
// with zero embedding calls. The column is dimensionless "vector" because the
// dimension is owned by the embedding-model configuration, not the schema;
// all access goes through raw SQL in app/catalog/embed.server.ts, which casts
// through the configured dimension so a mismatch fails loudly.
model ProductEmbedding {
  id          String                 @id @default(uuid())
  shopDomain  String
  productId   String
  contentHash String
  embedding   Unsupported("vector")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([shopDomain, productId])
  @@index([shopDomain])
}

// Shopper search log (YOY-47): exactly one row per proxy search request —
// including degraded, zero-hit, and throttled searches — for the dashboard
// and attribution work of later milestones. Write-only in this milestone.
model SearchEvent {
  id          String   @id @default(uuid())
  searchId    String
  shopDomain  String
  sessionId   String
  query       String
  route       String
  degraded    Boolean
  latencyMs   Int
  resultCount Int
  createdAt   DateTime @default(now())

  @@index([shopDomain, createdAt])
  // The click beacon validates its searchId against this table.
  @@index([searchId])
}

// Shopper click log (YOY-47): one row per click-beacon call whose searchId
// was verified to belong to the signed shop. Write-only in this milestone.
model ClickEvent {
  id         String   @id @default(uuid())
  searchId   String
  shopDomain String
  sessionId  String
  productId  String
  position   Int
  createdAt  DateTime @default(now())

  @@index([shopDomain, createdAt])
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
