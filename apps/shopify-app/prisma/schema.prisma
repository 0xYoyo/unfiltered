// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Cost-metering ledger: one row per AI call, written through the CostRecorder
// port so no AI spend is ever unmetered.
model AiCall {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  provider     String
  modelId      String
  operation    String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  shopDomain   String?
  searchId     String?

  @@index([searchId])
}

// Per-shop catalog snapshot: one row per Shopify product, in the shape the
// engine and later enrichment/embedding steps consume (YOY-20).
model CatalogProduct {
  id              String   @id @default(uuid())
  shopDomain      String
  productId       String
  title           String
  description     String
  tags            String[]
  vendor          String
  productType     String
  priceMin        Float
  priceMax        Float
  currencyCode    String
  available       Boolean
  imageAltTexts   String[]
  sourceUpdatedAt DateTime
  // SHA-256 over the searchable fields; unchanged hash means the row is
  // untouched on re-ingestion.
  contentHash     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shopDomain, productId])
  @@index([shopDomain])
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
