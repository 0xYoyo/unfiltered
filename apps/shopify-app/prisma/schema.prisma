// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
// Two connection strings (YOY-115 AC-5): queries go over DATABASE_URL — on
// Render, Neon's pooled `-pooler` host (PgBouncer, transaction mode) — and
// migrations go over DIRECT_DATABASE_URL, the direct host, because
// `prisma migrate deploy` needs session-level features a transaction pooler
// does not offer. Locally and in the entrypoint the two may be the same
// unpooled URL; the entrypoint defaults DIRECT_DATABASE_URL to DATABASE_URL.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// Cost-metering ledger: one row per AI call, written through the CostRecorder
// port so no AI spend is ever unmetered.
model AiCall {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  provider     String
  modelId      String
  operation    String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  shopDomain   String?
  searchId     String?

  @@index([searchId])
}

// Per-shop catalog snapshot: one row per Shopify product, in the shape the
// engine and later enrichment/embedding steps consume (YOY-20).
model CatalogProduct {
  id              String   @id @default(uuid())
  shopDomain      String
  productId       String
  title           String
  description     String
  tags            String[]
  vendor          String
  productType     String
  priceMin        Float
  priceMax        Float
  currencyCode    String
  available       Boolean
  // Shopify product status (YOY-61 AC-3). Ingestion and webhook sync only
  // ever write ACTIVE products, so this stays "ACTIVE" in practice; both
  // search stores still filter on it as defense in depth — a non-active row
  // that reaches the table by any other path must never be served.
  status          String   @default("ACTIVE")
  // When the product was published to the Online Store sales channel, as of
  // the last sync (YOY-67 AC-4). Status and channel publication are
  // independent axes: ACTIVE but never published still 404s on the
  // storefront. Ingestion and webhook sync drop unpublished products, so
  // this is non-null in practice; both search stores filter on it as defense
  // in depth. Nullable with a now() default so pre-migration rows and test
  // seeds that predate the column stay served; sync paths always write the
  // real value.
  publishedAt     DateTime? @default(now())
  imageAltTexts   String[]
  // Display-only snapshot fields (YOY-44): storefront handle and featured
  // image for result cards. Deliberately OUTSIDE contentHash — a change here
  // must not dirty the searchable content or trigger re-enrichment.
  handle          String   @default("")
  featuredImageUrl String?
  // Product-family key (YOY-117 AC-1): lower(vendor) + "|" + the title with
  // one trailing colourway designator stripped [+ "|" + lower(productType)
  // when present]. Colourways of one product share it, so both stores return
  // one card per family. Display-only like `handle`: outside contentHash,
  // refreshed on every sync. "" (the backfill for pre-migration rows) means
  // "own family" — an empty key never collapses with another row.
  familyKey       String   @default("")
  // Server-resolved product link for result cards (YOY-87, LEAK-2): the
  // ingestion adapter that knows the storefront resolves it once; no
  // renderer composes a URL. Display-only, outside contentHash like the
  // fields above; null when no adapter could resolve one.
  url             String?
  sourceUpdatedAt DateTime
  // SHA-256 over the searchable fields; unchanged hash means the row is
  // untouched on re-ingestion.
  contentHash     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shopDomain, productId])
  @@index([shopDomain, familyKey])
  @@index([shopDomain])
}

// LLM-derived structured attributes for one snapshot row (YOY-22). Keyed by
// the snapshot's contentHash so enrichment is cached: an unchanged product
// re-enriches with zero LLM calls. status is "enriched" or "failed"; failed
// rows keep the hash so a deterministic bad product is not retried until its
// content changes.
model ProductEnrichment {
  id          String   @id @default(uuid())
  shopDomain  String
  productId   String
  contentHash String
  status      String
  category    String?
  colors      String[]
  occasions   String[]
  fit         String?
  styleTags   String[]
  seasons     String[]
  // The product's primary/displayed colour (YOY-110): the title's colourway
  // designator, else the first colour the text states; null when unknown.
  // Colour EXCLUSIONS apply to this column only; `colors` keeps every
  // stated colourway for inclusions.
  primaryColor      String?
  // ENRICHMENT_VERSION (app/catalog/enrich.server.ts) at the time the row
  // was written: a row at an older version re-enriches on the next run even
  // when its contentHash is unchanged. 0 = written before versioning.
  enrichmentVersion Int      @default(0)
  // Vision enrichment (YOY-121; PRD capability 14). The five vision-only
  // coverage attributes, values from the committed vocabularies in
  // packages/engine/src/taxonomy.ts (null = not applicable / unknown).
  sleeveLength       String?
  neckline           String?
  garmentLength      String?
  pattern            String?
  materialAppearance String?
  // The ProductImage contentHashes (position order) the vision pass last
  // analysed for this product: the re-analysis key. A product whose
  // current image hashes differ is re-analysed on the next run; equal
  // hashes make zero vision calls. [] = never analysed.
  visionImageHashes  String[] @default([])
  // none (no images / never run) | enriched | failed (two attempts failed;
  // retried only when the image hashes change).
  visionStatus       String   @default("none")
  // The two sources the columns above are merged from (YOY-121 AC-3): the
  // text pass's own parsed answer and the vision pass's own parsed answer
  // (its shared-schema fields plus the five vision-only fields). Kept so
  // that re-running ONE side — text after a content change or version
  // bump over unchanged images, vision after an image change over
  // unchanged text — re-merges against what the other side actually said,
  // never against the previously merged columns. Null when that side never
  // ran or failed.
  textAttributes     Json?
  visionAttributes   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopDomain, productId])
  @@index([shopDomain])
}

// pgvector embedding for one snapshot row (YOY-23), keyed by the snapshot's
// contentHash so embedding runs are incremental: an unchanged product re-runs
// with zero embedding calls. The column is dimensionless "vector" because the
// dimension is owned by the embedding-model configuration, not the schema;
// all access goes through raw SQL in app/catalog/embed.server.ts, which casts
// through the configured dimension so a mismatch fails loudly.
model ProductEmbedding {
  id          String                 @id @default(uuid())
  shopDomain  String
  productId   String
  contentHash String
  embedding   Unsupported("vector")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([shopDomain, productId])
  @@index([shopDomain])
}

// Product images (YOY-120 AC-1): up to four image URLs per product in
// source order, each with the SHA-256 of the image bytes, so vision
// enrichment (PRD capability 14) re-analyses a product only when an image's
// content changed. Bytes are hashed at ingestion and discarded — never
// stored, never resized (NG-2). Outside the product's contentHash: an image
// change is tracked here and never dirties the searchable content or
// triggers text re-enrichment (AC-2). Keyed by tenant + product + position
// with no FK cascade, like enrichment and embedding rows: every product
// delete removes these in the same transaction. Rows hold DISTINCT images:
// a source URL whose bytes hash identical to an earlier one (a CDN serving
// one asset under several suffixes) is recorded as a duplicateUrl of that
// row instead of a row of its own, so the four-image cap counts pictures,
// not links.
model ProductImage {
  id          String   @id @default(uuid())
  shopDomain  String
  productId   String
  // 0–3: the image's position among the product's distinct images, in source order.
  position    Int
  // The first source URL that produced this image.
  url         String
  // Later source URLs whose bytes hashed identical to `url`'s: known, never re-fetched.
  duplicateUrls String[] @default([])
  // sha256 of the fetched bytes, hex.
  contentHash String
  fetchedAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopDomain, productId, position])
  @@index([shopDomain, productId])
}

// Product variants (YOY-142 AC-1): every variant as the merchant defined it
// — size, stock and per-variant price, which the snapshot row collapses to
// min/max price and "any variant available". Option names and values are
// stored verbatim, in the merchant's order (AC-6). Outside the product's
// contentHash (NG-4): a variant change never re-enriches or re-embeds.
// Keyed by tenant + product + variant with no FK cascade, like the image,
// enrichment and embedding rows: every product delete removes these in the
// same transaction (AC-7). At most the first 100 variants per product (NG-3).
model ProductVariant {
  id              String    @id @default(uuid())
  shopDomain      String
  productId       String
  // The source's own variant identifier (an Admin GID, a feed id, a sku).
  variantId       String
  // 1-based position among the product's variants, in source order.
  position        Int
  // [{ "name": "Size", "value": "M" }, ...] — verbatim, merchant order.
  options         Json
  price           Float
  available       Boolean
  // Stock on hand when the source exposes it; null otherwise.
  quantity        Int?
  // The source's own updated-at for this variant (or its product); null
  // when the source carries none.
  sourceUpdatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([shopDomain, productId, variantId])
  @@index([shopDomain, productId])
}

// The product card (YOY-143; PRD §3 Engine v2, Refinements 5–6): a
// plain-text dossier a model writes once per product at load time, which
// later steps find and judge against. `facts` (what the item is and the
// merchant's stated details, material first; a photo-only detail reads
// "looks like …"), `look` (what it looks like), `read` (style, occasion,
// who wears it — the model's read, never shown to shoppers), `summary`
// (≤ 300 characters) and `asks` ({ "<lang>": [10–20 ways to ask] }).
// `cardText` is the whole card as one text and `cardTextHash` its SHA-256,
// so the hash moves only when the text does. `inputHash` covers what the
// card was written from (the product's text, its enrichment, its image
// hashes, the ask languages): a row whose inputHash and cardVersion are
// current is never rewritten. status is "written" or "failed"; a failed
// row keeps its inputHash so it is retried only when the inputs change.
// Keyed by tenant + product with no FK cascade, like the enrichment rows:
// every product delete removes it in the same transaction.
model ProductCard {
  id           String   @id @default(uuid())
  shopDomain   String
  productId    String
  status       String
  facts        String   @default("")
  look         String   @default("")
  read         String   @default("")
  summary      String   @default("")
  asks         Json
  cardText     String   @default("")
  cardTextHash String   @default("")
  inputHash    String
  cardVersion  Int
  modelId      String
  writtenAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shopDomain, productId])
  @@index([shopDomain])
}

// Shopper search log (YOY-47): exactly one row per proxy search request —
// including degraded, zero-hit, and throttled searches — for the dashboard
// and attribution work of later milestones. Write-only in this milestone.
model SearchEvent {
  id          String   @id @default(uuid())
  searchId    String
  shopDomain  String
  sessionId   String
  query       String
  route       String
  // Why the search took its route (YOY-96 AC-9): the orchestrator's
  // routeReason — "throttled", "client-timeout-rescue", a classifier reason.
  // Nullable: rows written before the column carry no reason.
  routeReason String?
  degraded    Boolean
  latencyMs   Int
  resultCount Int
  // Exact-query intent reuse (YOY-64 AC-4): the query as the reuse key
  // (trimmed, whitespace-collapsed, case-folded) and the intent the search
  // was served with, both null on classic, degraded, and pre-column rows.
  normalizedQuery String?
  intent          Json?
  createdAt   DateTime @default(now())

  @@index([shopDomain, createdAt])
  // The click beacon validates its searchId against this table.
  @@index([searchId])
  // Intent reuse looks up the latest row for a shop's normalized query.
  @@index([shopDomain, normalizedQuery, createdAt])
}

// Shopper click log (YOY-47): one row per click-beacon call whose searchId
// was verified to belong to the signed shop. Write-only in this milestone.
model ClickEvent {
  id         String   @id @default(uuid())
  searchId   String
  shopDomain String
  sessionId  String
  productId  String
  position   Int
  createdAt  DateTime @default(now())

  @@index([shopDomain, createdAt])
}

// Playground catalog registry (YOY-88): one row per PUBLIC catalog the
// playground's store-preload mode has ingested through the generic
// catalog-source port. `storeKey` is the tenant key value the catalog's rows
// carry in CatalogProduct / ProductEnrichment / ProductEmbedding /
// SearchEvent / ClickEvent / AiCall (the `shopDomain` column) — always
// `playground:<slug>`, so playground tenants can never collide with a real
// shop domain. `sourceKind` is whatever the ingesting source declares
// (e.g. "shopify-public"); the registry itself knows no platform.
model PlaygroundCatalog {
  id             String    @id @default(uuid())
  slug           String    @unique
  name           String
  storeKey       String    @unique
  sourceUrl      String
  sourceKind     String
  productCount   Int       @default(0)
  lastIngestedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
