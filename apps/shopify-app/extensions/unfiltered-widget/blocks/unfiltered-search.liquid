{% comment %}
  Unfiltered search widget — app embed block (YOY-43 AC-1, YOY-48). Loads
  the built widget bundle from this extension's assets and initializes it
  with the storefront locale and shop domain. The widget takes over the
  theme's search input and renders results in a shadow-DOM overlay; its
  styles ship inside the bundle (injected into the shadow root), so there
  is no separate stylesheet to load.
{% endcomment %}
<script src="{{ 'unfiltered-widget.js' | asset_url }}" defer></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    if (window.UnfilteredWidget) {
      window.UnfilteredWidget.init({
        locale: {{ request.locale.iso_code | json }},
        shopDomain: {{ shop.permanent_domain | json }}
      });
    }
  });
</script>

{% schema %}
{
  "name": "Unfiltered search",
  "target": "body",
  "settings": []
}
{% endschema %}
