# Environment keys read by apps/shopify-app. Placeholder values only —
# copy to .env (gitignored) and fill in real values. Never commit secrets.

# --- Shopify app (read at import time by app/shopify.server.ts) ---
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_APP_URL=https://your-app-url.example.com
SCOPES=write_products

# --- Database (prisma/schema.prisma datasource) ---
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# --- AI provider (packages/provider-gemini, eval + ingest paths) ---
GEMINI_API_KEY=your-gemini-api-key

# --- Admin/internal routes (app/routes/internal.costs.tsx) ---
ADMIN_TOKEN=your-admin-token

# --- Optional ---
# Extra shop domain allowed by shopify.server.ts:
# SHOP_CUSTOM_DOMAIN=your-store.example.com
# Dev-server ports/host (set by Shopify CLI in dev; vite.config.ts reads them):
# HOST=
# PORT=
# FRONTEND_PORT=
# Target shop for scripts/ingest.mts and scripts/evidence.mts:
# INGEST_SHOP=your-store.myshopify.com
# EVIDENCE_SHOP=your-store.myshopify.com
# Opt-in live LLM tests and eval pacing:
# LIVE_LLM_TESTS=
# REGEN_PACE_MS=
